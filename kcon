#!/usr/bin/env python3
"""kcon - simple line console for Klipper's virtual serial port.

Type G-code and press Enter. Responses print as plain lines.
Local commands (start with a colon):
  :temps all|some|none   temperature report lines: every one, one per 10 s
                         (default), or none
  :quit                  exit (Ctrl+D or Ctrl+C also work)
Only one program can use the port at a time; close OctoPrint or any
`cat` on klippy.serial first.
"""
import argparse
import os
import re
import readline  # noqa: F401  (gives line editing and history to input())
import select
import sys
import threading
import time

DEFAULT_PORT = os.path.expanduser("~/printer_data/comms/klippy.serial")
HISTORY = os.path.expanduser("~/.kcon_history")
TEMP_RE = re.compile(r"^(ok\s+)?[BT]\d*:\s*-?\d")  # "B:37.1 /65.0 T0:..."


class Console:
    def __init__(self, port, temps):
        self.fd = os.open(port, os.O_RDWR | os.O_NOCTTY)
        self.temps = temps
        self.last_temp = 0.0
        self.running = True

    def show(self, line):
        if TEMP_RE.match(line):
            if self.temps == "none":
                return
            if self.temps == "some":
                now = time.monotonic()
                if now - self.last_temp < 10:
                    return
                self.last_temp = now
        print(line, flush=True)

    def reader(self):
        buf = b""
        while self.running:
            ready, _, _ = select.select([self.fd], [], [], 0.5)
            if not ready:
                continue
            try:
                chunk = os.read(self.fd, 4096)
            except OSError:
                print("-- connection lost (Klipper restarted?) --", flush=True)
                self.running = False
                break
            if not chunk:
                continue
            buf += chunk
            while b"\n" in buf:
                raw, buf = buf.split(b"\n", 1)
                line = raw.decode("utf-8", "replace").strip("\r ")
                if line:
                    self.show(line)

    def send(self, line):
        os.write(self.fd, (line + "\n").encode("utf-8"))

    def run(self):
        threading.Thread(target=self.reader, daemon=True).start()
        print("kcon connected. Type G-code, :temps all|some|none, :quit",
              flush=True)
        while self.running:
            try:
                line = input().strip()
            except (EOFError, KeyboardInterrupt):
                break
            if not line:
                continue
            if line == ":quit":
                break
            if line.startswith(":temps"):
                mode = line.split()[-1]
                if mode in ("all", "some", "none"):
                    self.temps = mode
                    print("temps: " + mode, flush=True)
                else:
                    print("usage: :temps all|some|none", flush=True)
                continue
            if not self.running:
                print("-- not connected; restart kcon --", flush=True)
                break
            self.send(line)
        self.running = False


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawTextHelpFormatter)
    ap.add_argument("port", nargs="?", default=DEFAULT_PORT)
    ap.add_argument("--temps", choices=("all", "some", "none"), default="some")
    args = ap.parse_args()
    try:
        readline.read_history_file(HISTORY)
    except OSError:
        pass
    try:
        Console(args.port, args.temps).run()
    finally:
        try:
            readline.write_history_file(HISTORY)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
